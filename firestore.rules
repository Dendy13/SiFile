// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: jobs
// Document ID: UUID (generated by backend)
// Fields:
//   - id: string (required, immutable) - Job UUID
//   - userId: string (required, immutable) - Firebase Auth UID
//   - operation: string (required, immutable) - e.g. 'pdf-compress', 'image-resize'
//   - status: string (required) - enum: 'pending' | 'processing' | 'done' | 'error'
//   - fileId: string (required, immutable) - uploaded file reference
//   - storagePath: string (required, immutable) - Firebase Storage path (input)
//   - params: map (required) - processing parameters
//   - suggestedParams: map (required) - agentic suggested params
//   - progress: number (required) - 0–100
//   - resultUrl: string (optional) - signed URL for download
//   - resultStoragePath: string (optional) - Firebase Storage path (output)
//   - inputSizeBytes: number (optional) - input file size
//   - outputSizeBytes: number (optional) - output file size
//   - errorMessage: string (optional) - error description
//   - createdAt: timestamp (required, immutable)
//   - updatedAt: timestamp (required)
//
// Collection: users/{uid}/usage/{YYYY-MM}
// Document ID: YYYY-MM (month string)
// Fields: (all optional, incremented by server)
//   - events.file_upload: number
//   - events.operation_start: number
//   - events.operation_complete: number
//   - events.operation_error: number
//   - events.download: number
//   - operations_count: number
//   - operations_by_type: map
//   - last_active: timestamp
//
// Collection: users/{uid}/operations/{op_id}
// Fields:
//   - type: string (required, immutable)
//   - status: string (required)
//   - inputSizeBytes: number (optional)
//   - outputUrl: string (optional)
//   - createdAt: timestamp (required, immutable)
//
// NOTE: All writes to Firestore are done via Firebase Admin SDK (backend only).
// The client SDK (frontend) only reads jobs (to poll status via SSE) and
// reads user usage/history. No client-side writes to jobs collection.
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // Helper Functions
    // ═══════════════════════════════════════════════════════════

    // Check if the request comes from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns this resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate a string field: present, correct type, within length bounds
    function isValidString(field, minLen, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() >= minLen
        && request.resource.data[field].size() <= maxLen;
    }

    // Validate job status enum values
    function isValidJobStatus(data) {
      return data.status in ['pending', 'processing', 'done', 'error'];
    }

    // Validate job operation string
    function isValidOperation(data) {
      return data.operation in [
        'pdf-compress', 'pdf-merge', 'pdf-split', 'pdf-to-image',
        'image-to-pdf', 'pdf-rotate', 'pdf-watermark', 'pdf-extract-pages',
        'image-compress', 'image-resize', 'image-convert',
        'image-crop', 'image-remove-bg', 'image-watermark', 'image-rotate'
      ];
    }

    // Validate a job document on create (only backend via Admin SDK creates jobs,
    // but rules are defense-in-depth)
    function isValidJob(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && isValidOperation(data)
        && isValidJobStatus(data)
        && data.fileId is string && data.fileId.size() >= 1 && data.fileId.size() <= 256
        && data.storagePath is string && data.storagePath.size() >= 1 && data.storagePath.size() <= 512
        && data.params is map
        && data.suggestedParams is map
        && data.progress is number && data.progress >= 0 && data.progress <= 100;
    }

    // ═══════════════════════════════════════════════════════════
    // jobs collection
    // All writes are done exclusively via Firebase Admin SDK (backend).
    // Clients may only READ their own jobs (for progress polling).
    // ═══════════════════════════════════════════════════════════
    match /jobs/{jobId} {
      // Only the job owner can read their own job
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Backend (Admin SDK) bypasses all rules — these create/update rules
      // are defense-in-depth for client SDK misuse prevention only.
      // We deny all client-side writes.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // users/{uid} — profile & subcollections
    // ═══════════════════════════════════════════════════════════
    match /users/{userId} {
      // Users can only read their own profile
      allow read: if isOwner(userId);

      // Users cannot write their own profile directly (backend manages this)
      allow write: if false;

      // usage subcollection: read-only for owner
      match /usage/{month} {
        allow read: if isOwner(userId);
        allow write: if false; // backend only
      }

      // operations history: read-only for owner
      match /operations/{operationId} {
        allow read: if isOwner(userId);
        allow write: if false; // backend only
      }
    }

    // ═══════════════════════════════════════════════════════════
    // app_config — feature flags (read-only for all authenticated users)
    // ═══════════════════════════════════════════════════════════
    match /app_config/{document} {
      allow read: if isAuthenticated();
      allow write: if false; // admin console only
    }

    // ═══════════════════════════════════════════════════════════
    // Default deny — any path not explicitly matched above
    // ═══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
