# Environment variables for sifile-backend
# Copy this to .env for local development
# NEVER commit .env to git

# ─── Server ───────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── Frontend URL (CORS) ──────────────────────────
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://your-frontend-cloud-run-url.run.app

# ─── Firebase ─────────────────────────────────────
# Development: use Application Default Credentials (run: gcloud auth application-default login)
# Production: paste service account JSON as a single-line string
# FIREBASE_ADMIN_SDK={"type":"service_account","project_id":"..."}

FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ─── Upstash Redis ────────────────────────────────
REDIS_URL=https://your-upstash-url.upstash.io
REDIS_TOKEN=your-upstash-token

# ─── Feature Flags ────────────────────────────────
FREEMIUM_ENABLED=false
REQUIRE_AUTH=false
SHOW_UPGRADE_CTA=false
PAYMENT_ENABLED=false

# ─── File Processing ──────────────────────────────
MAX_FILE_SIZE_MB=200
TEMP_STORAGE_TTL_HOURS=24

# ─── AI / Agentic Layer (TBD) ─────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# AI_GATEWAY_URL=
# AI_GATEWAY_KEY=
